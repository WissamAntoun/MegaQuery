# Source from the repository root using examples/run_stage.sh.
CONFIG=fra_Latn
LANGUAGE=French
# A downloaded public release, containing manifests for both languages.
SOURCE_RELEASE=work/published-release
FINEPDF_ROOT=work/finepdfs
SOURCE_REVISION=220bac3acbf07789502c621d2d33952f51ac7f86
WORK_ROOT=work/fra_Latn
PERSONA_PATH=work/personas.jsonl
PERSONA_EMBEDDINGS=work/persona_embeddings.npy
GEN_MODEL=google/gemma-3-1b-it
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=wissamantoun/bge-reranker-v2-gemma-seq-cls
PROVENANCE=configs/provenance.example.json
# Independent file-level worker partitions for each stage. Rank starts at zero.
GEN_RANK=0
GEN_WORLD_SIZE=1
EMBED_RANK=0
EMBED_WORLD_SIZE=1
MINE_RANK=0
MINE_WORLD_SIZE=1
# Portable starting points; adjust memory/batches for your own hardware.
CONCURRENCY=1
EMBED_CONCURRENCY=1
RERANKER_CONCURRENCY=1
TENSOR_PARALLEL_SIZE=1
RERANKER_TP_SIZE=1
CPUS_PER_REPLICA=4
GEN_BATCH_SIZE=64
PASSAGE_EMBED_BATCH_SIZE=128
ENCODE_BATCH_SIZE=256
COMPACT_WORKERS=1
COMPACT_FILES_PER_BATCH=10
THREADS=8
TRAIN_WORKERS=1
EXPORT_MEMORY=8GB
# Optional Ray object store limit, in GiB. Unset lets Ray choose.
# RAY_OBJECT_STORE_MEMORY_GB=8
